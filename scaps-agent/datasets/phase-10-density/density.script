set quitscript.quitSCAPS
set script_display_mode.suppressed
load definitionfile D:\SJCM\01_SemiconductorStudio\SST-Experiments-gui-bridge\scaps-agent\runs\phase-10\density-0-input.def
clear actions
clear simulations
action dark
action workingpoint.temperature 300
action workingpoint.voltage 0
action workingpoint.frequency 1e6
